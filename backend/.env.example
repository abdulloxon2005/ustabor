APP_NAME=UstaBor
ENVIRONMENT=development

# SQLite hozir, keyin PostgreSQL: postgresql+psycopg://user:pass@host:5432/ustabor
DATABASE_URL=sqlite:///./ustabor.db

# Yaratish: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bu-yerga-uzun-tasodifiy-qiymat

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vergul bilan ajratiladi
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Foiz (butun son)
COMMISSION_RATE=10
# Faqat seed skript uchun. Productionda albatta o'zgartiring!
SEED_ADMIN_PHONE=+998900000000
SEED_ADMIN_PASSWORD=admin12345

# Yandex xarita/geokodlash: https://developer.tech.yandex.ru/ dan oling.
# Yandex har bir mahsulot uchun ALOHIDA kalit beradi — ikkalasi bir xil bo'lmaydi:
#   - Geocoder API: backend manzil qidirish proxy uchun
#   - JavaScript API: frontend xarita ko'rsatish uchun (HTTP-referrer bilan cheklang)
# Bo'sh qoldirilsa tegishli funksiya o'chirilgan bo'ladi.
YANDEX_GEOCODER_API_KEY=
YANDEX_MAPS_JS_API_KEY=

# FCM HTTP v1 (push o'chirilgan bo'ladi, ikkalasi ham bo'sh bo'lsa).
# Access tokenni secret manager orqali bering va muddati tugashidan oldin yangilang.
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
