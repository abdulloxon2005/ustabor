# Production (Docker Compose) uchun muhit namunasi.
# Ko'chiring:  cp backend/.env.production.example backend/.env
# va pastdagi MAJBURIY qiymatlarni to'ldiring. Bu fayl .gitignore'da (hech qachon commit qilinmaydi).

APP_NAME=UstaBor
ENVIRONMENT=production

# Docker tomida (volume) saqlanadi — konteyner qayta qurilganda ham ma'lumot yo'qolmaydi.
# E'tibor bering: 4 ta "/" — bu mutlaq yo'l (/app/data/ustabor.db).
DATABASE_URL=sqlite:////app/data/ustabor.db

# MAJBURIY. Generatsiya qiling:
#   docker compose run --rm backend python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MAJBURIY: haqiqiy domeningiz (vergul bilan bir nechta domen, https:// bilan)
CORS_ORIGINS=https://sizning-domeningiz.uz

COMMISSION_RATE=10

# MAJBURIY: admin telefon raqami va KUCHLI parol (standart admin12345 bilan
# ENVIRONMENT=production holida scripts.seed ataylab ishlamay qoladi).
SEED_ADMIN_PHONE=+998901234567
SEED_ADMIN_PASSWORD=

# Ixtiyoriy: Yandex xarita/geokodlash (https://developer.tech.yandex.ru/)
YANDEX_GEOCODER_API_KEY=
YANDEX_MAPS_JS_API_KEY=

# Ixtiyoriy: Firebase push bildirishnomalar
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
