# SmartUsta — HTTPS yoqilgandan keyin ishlatiladigan Nginx konfiguratsiyasi namunasi.
#
# Qanday ishlatiladi (docs/deploy.md'da batafsil):
#   1. Avval oddiy nginx.conf (HTTP) bilan saytni ishga tushiring va domenni DNS orqali
#      server IP'ga yo'naltiring.
#   2. Certbot orqali sertifikat oling (docs/deploy.md'dagi buyruq).
#   3. SIZNING-DOMENINGIZ.uz o'rniga haqiqiy domeningizni qo'yib, shu faylni
#      frontend/nginx.conf sifatida saqlang va `docker compose build frontend && docker compose up -d frontend`
#      buyrug'ini bajaring.

server {
    listen 80;
    server_name SIZNING-DOMENINGIZ.uz www.SIZNING-DOMENINGIZ.uz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name SIZNING-DOMENINGIZ.uz www.SIZNING-DOMENINGIZ.uz;
    client_max_body_size 10m;

    ssl_certificate     /etc/letsencrypt/live/SIZNING-DOMENINGIZ.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/SIZNING-DOMENINGIZ.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/v1/ {
        proxy_pass http://backend:8000/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        alias /usr/share/nginx/media/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
